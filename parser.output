Grammar

    0 $accept: program $end

    1 program: func
    2        | program func

    3 func: type ID '(' params ')' block

    4 type: INT
    5     | DOUBLE
    6     | VOID

    7 params: ε
    8       | VOID
    9       | param_list

   10 param_list: param
   11           | param_list ',' param

   12 param: type ID

   13 block: '{' stmt_list '}'

   14 stmt_list: ε
   15          | stmt_list stmt

   16 stmt: block
   17     | decl ';'
   18     | expr ';'
   19     | ';'
   20     | IF '(' expr ')' stmt
   21     | IF '(' expr ')' stmt ELSE stmt
   22     | WHILE '(' expr ')' stmt
   23     | FOR '(' for_init ';' expr_opt ';' expr_opt ')' stmt
   24     | RETURN expr_opt ';'
   25     | BREAK ';'

   26 for_init: expr_opt
   27         | decl

   28 decl: type init_list

   29 init_list: init
   30          | init_list ',' init

   31 init: ID
   32     | ID '=' expr

   33 expr_opt: ε
   34         | expr

   35 expr: ID '=' expr
   36     | ID ADD_ASSIGN expr
   37     | ID SUB_ASSIGN expr
   38     | ID MUL_ASSIGN expr
   39     | ID DIV_ASSIGN expr
   40     | ID MOD_ASSIGN expr
   41     | expr OR expr
   42     | expr AND expr
   43     | expr EQ expr
   44     | expr NE expr
   45     | expr '<' expr
   46     | expr '>' expr
   47     | expr LE expr
   48     | expr GE expr
   49     | expr '+' expr
   50     | expr '-' expr
   51     | expr '*' expr
   52     | expr '/' expr
   53     | expr '%' expr
   54     | '-' expr
   55     | '!' expr
   56     | INC ID
   57     | DEC ID
   58     | ID INC
   59     | ID DEC
   60     | '(' expr ')'
   61     | NUM
   62     | FNUM
   63     | STRING
   64     | ID
   65     | ID '(' args ')'

   66 args: ε
   67     | arg_list

   68 arg_list: expr
   69         | arg_list ',' expr


